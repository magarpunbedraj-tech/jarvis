# Recommended free API-first setup (leave Ollama optional)
# Primary OpenAI-compatible provider (optional)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Groq free developer tier (OpenAI-compatible)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=

# OpenRouter free models (model IDs commonly end in :free; check current catalog)
