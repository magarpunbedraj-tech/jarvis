OPENROUTER_MODEL=

# Gemini API free tier (native REST)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional local fallback only
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
